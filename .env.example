# ==============================================================================
# Environment Configuration
# Copy this file to .env and replace placeholder values with your secure secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & Authentication Secrets (Required by FastAPI)
# ------------------------------------------------------------------------------
# Use a unique random value of at least 32 characters
JWT_SECRET_KEY=replace-with-a-secure-random-value-at-least-32-chars-long
JWT_EXPIRE_MINUTES=60
PORT=8000

# Comma-separated list of allowed CORS origins
# In production on AWS, include your deployed Streamlit URL / domain
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://frontend:8501

# Local Python paths when Uvicorn starts from backend/ (Compose overrides these)
DATABASE_PATH=users.db
AUDIT_LOG_PATH=logs/audit_log.jsonl

# ------------------------------------------------------------------------------
# Frontend Dashboard Secrets (Required by Streamlit)
# ------------------------------------------------------------------------------
# URL pointing to the FastAPI backend
# For local Python: http://127.0.0.1:8000
# For Docker Compose: http://backend:8000
# AWS is postponed; no cloud API URL is configured
FRAUD_API_URL=http://127.0.0.1:8000

# Required encryption password for streamlit-cookies-manager session cookies
COOKIE_PASSWORD=replace-with-a-secure-random-value-at-least-32-chars-long

# ------------------------------------------------------------------------------
# AWS deployment is postponed. Do not configure cloud secrets for local use.
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# ECR_BACKEND_REPO=fraud-detection-backend
# ECR_FRONTEND_REPO=fraud-detection-frontend
# APP_RUNNER_BACKEND_ARN=arn:aws:apprunner:us-east-1:...
# APP_RUNNER_FRONTEND_ARN=arn:aws:apprunner:us-east-1:...
